generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailFolder {
  INBOX
  SENT
  DRAFT
  TRASH
  SPAM
  ARCHIVED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emails   Email[]
  sessions Session[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(    fields: [userId],    references: [id],    onDelete: Cascade  )

  @@index([userId])
}

model Email {
  id String @id @default(uuid())

  // Resend identifiers
  resendEmailId String? @unique
  messageId     String? @unique

  // Sender
  fromEmail String
  fromName  String?

  // Recipients
  to  Json @default("[]")
  cc  Json @default("[]")
  bcc Json @default("[]")

  // Attachments
  attachments Json @default("[]")

  // Email content
  subject String
  text    String?
  html    String?

  // Email state
  folder    EmailFolder @default(INBOX)
  isRead    Boolean     @default(false)
  isStarred Boolean     @default(false)

  // Timestamps
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Owner
  userId String
  user   User @relation(fields: [userId],    references: [id],onDelete: Cascade  )

  @@index([userId])
  @@index([folder])
  @@index([receivedAt])
  @@index([fromEmail])
}